{
  "name": "lol-build-coach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:plain": "vite",
    "electron:dev": "node scripts/electron-dev.mjs",
    "aggregate": "node scripts/aggregate-builds.mjs",
    "aggregate:ranked": "node scripts/aggregate-ranked-stats.mjs",
    "aggregate:ranked:lowelo": "node scripts/aggregate-ranked-stats.mjs --buckets iron_bronze,silver_gold,plat_emerald,diamond --since 14 --pages 8 --per-player 15 --matches 1500",
    "augments:meta": "node scripts/fetch-augments.mjs",
    "aggregate:augments": "node scripts/aggregate-augments.mjs",
    "aggregate:augments:arena": "node scripts/aggregate-augments.mjs --meta src/data/augmentsArena.json --out src/data/augmentStatsArena.json --champ-out src/data/augmentChampStatsArena.json",
    "mayhem:stats": "node scripts/fetch-mayhem-stats.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "augments:preview": "node scripts/build-augments-preview.mjs",
    "overlay:shot": "node scripts/screenshot-overlay.mjs",
    "package:win": "node scripts/package-win.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
